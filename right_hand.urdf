<?xml version="1.0"?>
<robot name="inmoov_right_hand">

  <material name="frame_color">
    <color rgba="0.4 0.4 0.4 1"/>
  </material>
  <material name="cover_color">
    <color rgba="0.75 0.75 0.75 1"/>
  </material>

  <!-- Base link (fixed world frame) -->
  <link name="base_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base_to_hand_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="r_hand_link"/>
  </joint>

  <!-- ==================== PALM ==================== -->
  <link name="r_hand_link">
    <visual>
      <geometry>
        <mesh filename="meshes/r_hand.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="frame_color"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ==================== THUMB ==================== -->
  <link name="r_thumb1_link">
    <visual>
      <geometry>
        <mesh filename="meshes/r_thumb5_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="frame_color"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="r_thumb2_link">
    <visual>
      <geometry>
        <mesh filename="meshes/thumb5_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="frame_color"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="r_thumb3_link">
    <visual>
      <geometry>
        <mesh filename="meshes/thumb5_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="frame_color"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- thumb1_joint: mimic of thumb_joint, Z-axis, multiplier=0.75 -->
  <joint name="r_thumb1_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-0.0873" upper="1.1345" velocity="1.0"/>
    <origin rpy="0.1 0 0" xyz="0 0.029 -0.0577"/>
    <parent link="r_hand_link"/>
    <child link="r_thumb1_link"/>
  </joint>

  <!-- thumb_joint: CONTROL joint, Y-axis -->
  <joint name="r_thumb_joint" type="revolute">
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-0.0873" upper="1.1345" velocity="1.0"/>
    <origin rpy="0.825 -0.1 0.3" xyz="-0.00052 0.02725 -0.013"/>
    <parent link="r_thumb1_link"/>
    <child link="r_thumb2_link"/>
  </joint>

  <!-- thumb3_joint: mimic of thumb_joint, Y-axis, multiplier=1.0 -->
  <joint name="r_thumb3_joint" type="revolute">
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-0.0873" upper="1.1345" velocity="1.0"/>
    <origin rpy="0 0 0" xyz="0 0 -0.035"/>
    <parent link="r_thumb2_link"/>
    <child link="r_thumb3_link"/>
